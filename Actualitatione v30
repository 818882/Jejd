async def process_single_video_data(client, message, bot_is_admin):
    user_id = message.from_user.id if message.from_user else 0
    group_id = message.chat.id
    file_path = None
    
    try:
        v_unique_id = message.video.file_unique_id
        v_size = message.video.file_size
        v_dur = message.video.duration
        v_hash = None

        if message.video.thumbs:
            file_path = await custom_download_media(client, message.video.thumbs[0].file_id, f"thumb_{message.id}.jpg", chat_id=group_id)
            if file_path and not is_low_entropy_image(file_path):
                with Image.open(file_path) as img:
                    v_hash = str(imagehash.phash(img))
            elif file_path and os.path.exists(file_path):
                os.remove(file_path)
                file_path = None

        if not v_hash:
            file_path = await custom_download_media(client, message.video.file_id, f"vid_{message.id}.mp4", chat_id=group_id)
            if file_path:
                v_hash = extract_phash_from_frame(file_path)

        is_clon, level = check_multipoint_duplicate(group_id, v_unique_id, v_size, v_dur, v_hash)

        if is_clon:
            if bot_is_admin:
                add_to_deletion_queue(group_id, message.id)
            return "duplicate", (message.from_user.mention if message.from_user else f"ID {user_id}", level)
        else:
            return "valid", (v_hash, group_id, v_unique_id, v_size, v_dur, user_id)
    finally:
        if file_path and os.path.exists(file_path):
            os.remove(file_path)

async def process_video_batch(client, messages):
    async with processing_semaphore:
        if not messages:
            return 0, 0, []

        group_id = messages[0].chat.id
        group_title = messages[0].chat.title or ""
        bot_is_admin = await is_bot_admin_in_chat(client, group_id)

        valid_messages = []
        records_to_insert = []
        user_stats_map = {}
        detected_clones = []

        for msg in messages:
            status, data = await process_single_video_data(client, msg, bot_is_admin)
            if status == "duplicate":
                detected_clones.append(data)
            elif status == "valid":
                valid_messages.append(msg)
                records_to_insert.append(data)

        if not valid_messages:
            return 0, len(detected_clones), detected_clones

        saved_count = 0
        try:
            if len(valid_messages) > 1:
                media_group = [InputMediaVideo(media=m.video.file_id, caption=m.caption or "") for m in valid_messages]
                start_t = time.time()
                await client.send_media_group(chat_id=DESTINATION_CHAT_ID, media=media_group)
                await adjust_backoff(time.time() - start_t)
                saved_count = len(valid_messages)
            else:
                copied = await safe_copy_message(client, valid_messages[0], DESTINATION_CHAT_ID)
                if copied:
                    saved_count = 1

        except Exception as batch_error:
            await send_error_alert(client, "process_video_batch (Fallback Individual)", batch_error)
            for idx, msg in enumerate(valid_messages):
                copied = await safe_copy_message(client, msg, DESTINATION_CHAT_ID)
                if copied:
                    saved_count += 1
                    rec = records_to_insert[idx]
                    cursor.execute("INSERT INTO videos (phash, group_id, file_unique_id, file_size, duration) VALUES (?, ?, ?, ?, ?)", rec[:5])
                    if rec[5] != 0:
                        cursor.execute("""
                        INSERT INTO user_stats (user_id, group_id, video_count) VALUES (?, ?, 1)
                        ON CONFLICT(user_id, group_id) DO UPDATE SET video_count = video_count + 1
                        """, (rec[5], rec[1]))
                    conn.commit()

        if saved_count > 0 and saved_count == len(valid_messages):
            for rec in records_to_insert:
                cursor.execute("INSERT INTO videos (phash, group_id, file_unique_id, file_size, duration) VALUES (?, ?, ?, ?, ?)", rec[:5])
                u_id, g_id = rec[5], rec[1]
                if u_id != 0:
                    user_stats_map[(u_id, g_id)] = user_stats_map.get((u_id, g_id), 0) + 1

            for (u_id, g_id), count in user_stats_map.items():
                cursor.execute("""
                INSERT INTO user_stats (user_id, group_id, video_count) VALUES (?, ?, ?)
                ON CONFLICT(user_id, group_id) DO UPDATE SET video_count = video_count + ?
                """, (u_id, g_id, count, count))

            conn.commit()

        if saved_count > 0:
            await update_backup_channel_counter(client, saved_count, group_title)

        gc.collect()
        return saved_count, len(detected_clones), detected_clones

# --- WORKER CONSUMIDOR DE LA COLA FIFO (asyncio.Queue) ---
async def worker_process_batch_queue(client):
    while True:
        try:
            messages = await batch_queue.get()
            if not messages:
                batch_queue.task_done()
                continue

            first_msg = messages[0]
            bot_is_admin = await is_bot_admin_in_chat(client, first_msg.chat.id)

            saved_count, dup_count, detected_clones = await process_video_batch(client, messages)

            if bot_is_admin:
                if dup_count > 0:
                    summary_alert = (
                        f"🚨 **¡Video(s) Duplicado(s) Detectado(s)!**\n\n"
                        f"⚠️ **Cantidad de Clones:** `{dup_count}`\n"
                        f"🗑️ *Los videos han sido borrados automáticamente para evitar duplicados.*"
                    )
                    msg_dup = await safe_reply_message(first_msg, summary_alert)
                    if msg_dup:
                        asyncio.create_task(delete_message_later(msg_dup, delay=10))

                if saved_count > 0:
                    msg_ok = await safe_reply_message(first_msg, f"✅ **Procesado(s):** {saved_count} video(s).")
                    if msg_ok:
                        asyncio.create_task(delete_message_later(msg_ok, delay=10))

            batch_queue.task_done()
        except Exception as e:
            await send_error_alert(client, "worker_process_batch_queue", e)
            await asyncio.sleep(2)

# --- ENTRADA Y FLUSH DE BUFFERS ---
@app.on_message(filters.video & filters.group)
async def handle_video_entry(client, message):
    user_id = message.from_user.id if message.from_user else 0
    max_items, max_bytes = get_ram_limits()

    async with buffer_locks:
        if user_id not in user_buffers:
            user_buffers[user_id] = {"messages": [], "total_bytes": 0, "task": None}
        
        buf = user_buffers[user_id]
        v_size = message.video.file_size or 0

        if (len(buf["messages"]) + 1 > max_items) or (buf["total_bytes"] + v_size > max_bytes):
            if buf["task"]: buf["task"].cancel()
            buf["task"] = asyncio.create_task(flush_user_buffer_delayed(client, user_id, delay=0))
            
            user_buffers[user_id] = {"messages": [message], "total_bytes": v_size, "task": None}
            user_buffers[user_id]["task"] = asyncio.create_task(flush_user_buffer_delayed(client, user_id, delay=3.5))
        else:
            buf["messages"].append(message)
            buf["total_bytes"] += v_size
            if buf["task"]: buf["task"].cancel()
            buf["task"] = asyncio.create_task(flush_user_buffer_delayed(client, user_id, delay=3.5))

async def flush_user_buffer_delayed(client, user_id, delay=3.5):
    if delay > 0: await asyncio.sleep(delay)
    async with buffer_locks:
        buffer_data = user_buffers.pop(user_id, None)
        
    if not buffer_data or not buffer_data["messages"]: return

    await batch_queue.put(buffer_data["messages"])

