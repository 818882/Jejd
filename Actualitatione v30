        create_db_backup()
        date_info = get_db_date_range()
        cap = f"🗄️ **Respaldo Automático de Base de Datos**\n\n📌 Motivo: `{reason}`\n🔑 Hash: `{current_hash[:8]}`\n{date_info}"
