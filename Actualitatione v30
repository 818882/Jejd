# --- NUEVA FUNCIÓN: ESCANEO REMOTO DE MULTIMEDIA CON FRENO DE EMERGENCIA ---
@app.on_message(filters.command("scanremoto") & filters.private)
async def scan_remoto_cmd(client, message):
    if not is_authorized(message.from_user.id): return
    
    if not DESTINATION_CHAT_ID:
        await message.reply("⚠️ **Error:** No hay un Canal Destino configurado para reenviar la multimedia. Usa `/setdestination` primero.")
        return

    args = message.text.split()
    if len(args) < 2:
        await message.reply("⚠️ **Formato:** `/scanremoto <ID_DEL_GRUPO>`")
        return
        
    try:
        target_chat_id = int(args[1])
    except ValueError:
        await message.reply("🔴 **Error:** La ID debe ser numérica.")
        return

    msg_estado = await message.reply(f"⏳ **Iniciando escaneo remoto** en el grupo `{target_chat_id}`...\nVerificando historial y buscando multimedia...")

    try:
        # Obtener offset guardado para reanudar si hubo una caída anterior
        cursor.execute("SELECT last_message_id FROM scan_checkpoint WHERE group_id = ?", (target_chat_id,))
        cp_row = cursor.fetchone()
        offset_id = cp_row[0] if cp_row else 0
        
        total_revisados = 0
        total_enviados = 0
        
        while True:
            try:
                mensajes = []
                async for msg in client.get_chat_history(target_chat_id, limit=100, offset_id=offset_id):
                    mensajes.append(msg)
                    
                if not mensajes:
                    break # Se alcanzó el inicio del grupo
                    
                for msg in mensajes:
                    total_revisados += 1
                    # Filtrado estricto: Solo importan los videos y las fotos
                    if msg.video or msg.photo:
                        try:
                            # Reenviamos la multimedia pura y dura al almacén
                            await client.copy_message(DESTINATION_CHAT_ID, target_chat_id, msg.id)
                            total_enviados += 1
                        except FloodWait as fw:
                            raise fw # Pasar al except principal de FloodWait
                        except Exception:
                            pass # Ignorar archivos borrados o inaccesibles
                                
                # Checkpoint en SQLite (Sello de seguridad por lote)
                offset_id = mensajes[-1].id
                cursor.execute("INSERT OR REPLACE INTO scan_checkpoint (group_id, last_message_id) VALUES (?, ?)", (target_chat_id, offset_id))
                conn.commit()
                
                # Reporte en vivo cada 500 mensajes para no saturar edición
                if total_revisados % 500 == 0:
                    try:
                        await msg_estado.edit_text(
                            f"📊 **Escaneo Remoto en Progreso**\n\n"
                            f"📁 **Grupo:** `{target_chat_id}`\n"
                            f"💬 Mensajes revisados: **{total_revisados}**\n"
                            f"📤 Multimedia al Almacén: **{total_enviados}**\n"
                            f"📍 Offset Guardado: `{offset_id}`"
                        )
                    except Exception: pass
                        
            except FloodWait as e:
                # FRENO DE EMERGENCIA INTELIGENTE
                texto_base = f"🚨 **Freno de Emergencia Activado**\n\nTelegram limitó las peticiones.\n⏳ Pausa requerida: `{e.value}` segundos."
                try:
                    await msg_estado.edit_text(texto_base)
                    for remaining in range(e.value, 0, -5):
                        await asyncio.sleep(min(5, remaining))
                        try:
                            await msg_estado.edit_text(f"{texto_base}\n\n🔄 **Reanudando escaneo en:** `{max(0, remaining - 5)}` segundos...")
                        except Exception: pass
                except Exception:
                    await asyncio.sleep(e.value)
                    
                continue # Al terminar la pausa, el 'continue' reinicia el loop usando el mismo offset_id que no se perdió
                
        # Fin de escaneo
        await msg_estado.edit_text(
            f"✅ **Escaneo Remoto Finalizado**\n\n"
            f"📁 **Grupo ID:** `{target_chat_id}`\n"
            f"💬 Total revisados: **{total_revisados}**\n"
            f"📤 Multimedia enviada al Almacén: **{total_enviados}**"
        )
        
    except Exception as e:
        await msg_estado.edit_text(f"❌ **Error en el escaneo remoto:**\n`{str(e)}`")
        await send_error_alert(client, "scanremoto", e)

