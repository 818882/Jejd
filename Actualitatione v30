async def adjust_backoff(api_latency):
    global CURRENT_BACKOFF
    if api_latency < 0.3:
        CURRENT_BACKOFF = max(MIN_BACKOFF, CURRENT_BACKOFF - 0.1)
    elif api_latency > 1.5:
        CURRENT_BACKOFF = min(MAX_BACKOFF, CURRENT_BACKOFF + 0.3)

async def delete_message_later(message, delay=10):
    if not message or message.chat.type not in ["group", "supergroup"]:
        return
    await asyncio.sleep(delay)
    try:
        await message.delete()
    except Exception:
        pass

async def safe_copy_message(client, message, chat_id, retries=3):
    if not chat_id:
        return None
    global CURRENT_BACKOFF
    for attempt in range(retries):
        try:
            start_t = time.time()
            copied = await message.copy(chat_id=chat_id)
            latency = time.time() - start_t
            await adjust_backoff(latency)
            return copied
        except FloodWait as e:
            CURRENT_BACKOFF = min(MAX_BACKOFF, CURRENT_BACKOFF + 1.0)
            await asyncio.sleep(e.value + 1)
        except (PeerIdInvalid, ValueError) as e:
            print(f"⚠️ ID inválido o incompatible en safe_copy_message: {e}")
            return None
        except Exception as e:
            await asyncio.sleep(CURRENT_BACKOFF)
            if attempt == retries - 1:
                await send_error_alert(client, "safe_copy_message", e)
    return None

async def safe_reply_message(message, text, reply_markup=None):
    try:
        return await message.reply_text(text, reply_markup=reply_markup)
    except FloodWait as e:
        await asyncio.sleep(e.value + 1)
        try:
            return await message.reply_text(text, reply_markup=reply_markup)
        except Exception:
            return None
    except Exception:
        return None

