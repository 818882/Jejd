@app.on_callback_query(filters.regex(r"^(ask_revoke|confirm_revoke|cancel_revoke):"))
async def handle_revoke_callbacks(client, callback_query):
    if not is_master_admin(callback_query.from_user.id):
        await callback_query.answer("⚠️ Solo el Admin Maestro puede quitar permisos.", show_alert=True)
        return

    action, target_id_str = callback_query.data.split(":")
    target_id = int(target_id_str)

    if action == "ask_revoke":
        buttons = InlineKeyboardMarkup([
            [
                InlineKeyboardButton("✅ Sí, quitar permisos", callback_data=f"confirm_revoke:{target_id}"),
                InlineKeyboardButton("❌ No, cancelar", callback_data=f"cancel_revoke:{target_id}")
            ]
        ])
        await callback_query.message.edit_text(f"⚠️ **¿Confirmas revocar la ID `{target_id}`?**", reply_markup=buttons)
    elif action == "cancel_revoke":
        await callback_query.answer("Acción cancelada.")
        try: await callback_query.message.delete()
        except Exception: pass
    elif action == "confirm_revoke":
        if target_id in ALLOWED_ADMINS:
            ALLOWED_ADMINS.remove(target_id)
            cursor.execute("DELETE FROM allowed_admins WHERE user_id = ?", (target_id,))
            conn.commit()
            await callback_query.answer("Permisos revocados.", show_alert=True)
            await callback_query.message.edit_text(f"✅ **Permisos revocados para:** `{target_id}`")

