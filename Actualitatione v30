def add_to_deletion_queue(chat_id, message_id):
    cursor.execute("INSERT OR IGNORE INTO pending_deletions (chat_id, message_id) VALUES (?, ?)", (chat_id, message_id))
    conn.commit()

async def worker_process_deletion_queue(client):
    global CURRENT_BACKOFF
    while True:
        try:
            try:
                cursor.execute("SELECT id, chat_id, message_id FROM pending_deletions ORDER BY id ASC LIMIT 10")
                rows = cursor.fetchall()
            except sqlite3.ProgrammingError:
                await asyncio.sleep(5)
                continue

            if not rows:
                await asyncio.sleep(5)
                continue

            for row_id, chat_id, msg_id in rows:
                try:
                    start_t = time.time()
                    await client.delete_messages(chat_id=chat_id, message_ids=msg_id)
                    await adjust_backoff(time.time() - start_t)
                    
                    cursor.execute("DELETE FROM pending_deletions WHERE id = ?", (row_id,))
                    conn.commit()
                    await asyncio.sleep(max(1.0, CURRENT_BACKOFF))
                except FloodWait as e:
                    CURRENT_BACKOFF = min(MAX_BACKOFF, CURRENT_BACKOFF + 1.0)
                    await asyncio.sleep(e.value + 2)
                except RPCError:
                    cursor.execute("DELETE FROM pending_deletions WHERE id = ?", (row_id,))
                    conn.commit()
                except Exception:
                    await asyncio.sleep(2)
        except sqlite3.ProgrammingError:
            await asyncio.sleep(5)
        except Exception as e:
            await send_error_alert(client, "worker_process_deletion_queue", e)
            await asyncio.sleep(5)

# --- VERIFICACIÓN MULTIPUNTO EN 3 NIVELES ---
def is_low_entropy_image(image_path):
    try:
        with Image.open(image_path) as img:
            stat = ImageStat.Stat(img.convert('L'))
            if stat.stddev[0] < 8.0:
                return True
    except Exception:
        pass
    return False

def extract_phash_from_frame(video_path):
    thumb_path = f"{video_path}_sec3.jpg"
    try:
        ffmpeg_exe = imageio_ffmpeg.get_ffmpeg_exe()
        cmd = [ffmpeg_exe, "-y", "-ss", "00:00:03", "-i", video_path, "-vframes", "1", "-threads", "1", "-s", "320x240", thumb_path]
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e:
        print(f"Error ejecutando ffmpeg: {e}")
        return None
    
    hash_val = None
    if os.path.exists(thumb_path):
        if not is_low_entropy_image(thumb_path):
            with Image.open(thumb_path) as img:
                hash_val = str(imagehash.phash(img))
        os.remove(thumb_path)
    return hash_val

def check_multipoint_duplicate(group_id, file_unique_id, file_size, duration, v_hash):
    cursor.execute("SELECT id FROM videos WHERE file_unique_id = ?", (file_unique_id,))
    if cursor.fetchone():
        return True, "Nivel 1 (ID Único Global)"

    if v_hash:
        cursor.execute("SELECT phash, file_size, duration FROM videos WHERE phash IS NOT NULL")
        rows = cursor.fetchall()
        for stored_hash, stored_size, stored_dur in rows:
            size_match = stored_size and file_size and abs(stored_size - file_size) < 1024
            dur_match = stored_dur and duration and abs(stored_dur - duration) <= 1
            
            if stored_hash:
                diff = imagehash.hex_to_hash(v_hash) - imagehash.hex_to_hash(stored_hash)
                if diff <= 2 and (size_match or dur_match):
                    return True, "Nivel 3 (pHash + Metadatos)"
    return False, None

