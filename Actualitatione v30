# --- CORE DE ESCANEO DE HISTORIAL DE VIDEO EN TIEMPO REAL CON CHECKPOINT Y RE-SCAN FORZADO ---
async def execute_scan_logic(client, message, force_full=False):
    group_id = message.chat.id
    bot_is_admin = await is_bot_admin_in_chat(client, group_id)

    if group_id in active_scans:
        msg = await safe_reply_message(message, "⚠️ **Un escaneo ya está en progreso en este grupo.**")
        asyncio.create_task(delete_message_later(msg, delay=10))
        return

    active_scans.add(group_id)
    create_db_backup()

    try:
        top_msg = message.id
        if force_full:
            start_point = top_msg
        else:
            cursor.execute("SELECT last_message_id FROM scan_checkpoint WHERE group_id = ?", (group_id,))
            cp_row = cursor.fetchone()
            start_point = cp_row[0] if cp_row else top_msg

        total_estimated = max(1, start_point)
        current_id = start_point

        status_msg = None
        if bot_is_admin:
            status_msg = await safe_reply_message(
                message,
                f"📊 **Escaneo de Historial Iniciado**\n\n"
                f"📹 Videos analizados: **0 de {total_estimated} (0%)**\n"
                f"⚠️ Clones detectados: **0**\n"
                f"📍 Punto de control: `ID {current_id}`"
            )

        total_scanned = 0
        duplicates_found = 0
        last_update_time = time.time()
        batch_size = 100

        while current_id > 1:
            ids_to_fetch = list(range(max(1, current_id - batch_size), current_id))
            if not ids_to_fetch:
                break

            try:
                fetched_messages = await client.get_messages(group_id, ids_to_fetch)
            except Exception:
                await asyncio.sleep(1)
                current_id -= batch_size
                continue

            for msg in reversed(fetched_messages):
                if not msg or msg.empty:
                    continue

                current_id = msg.id
                cursor.execute("INSERT OR REPLACE INTO scan_checkpoint (group_id, last_message_id) VALUES (?, ?)", (group_id, current_id))
                conn.commit()

                if msg.video:
                    total_scanned += 1
                    v_unique_id = msg.video.file_unique_id
                    v_size = msg.video.file_size
                    v_dur = msg.video.duration
                    v_hash = None

                    if msg.video.thumbs:
                        try:
                            thumb_p = await custom_download_media(client, msg.video.thumbs[0].file_id, f"thumb_{msg.id}.jpg", chat_id=group_id)
                            if thumb_p and not is_low_entropy_image(thumb_p):
                                with Image.open(thumb_p) as img:
                                    v_hash = str(imagehash.phash(img))
                            if thumb_p and os.path.exists(thumb_p):
                                os.remove(thumb_p)
                        except Exception:
                            pass

                    is_clon, level = check_multipoint_duplicate(group_id, v_unique_id, v_size, v_dur, v_hash)
                    if is_clon:
                        duplicates_found += 1
                        if bot_is_admin:
                            add_to_deletion_queue(group_id, msg.id)
                    else:
                        if v_hash:
                            cursor.execute("INSERT OR IGNORE INTO videos (phash, group_id, file_unique_id, file_size, duration) VALUES (?, ?, ?, ?, ?)",
                                           (v_hash, group_id, v_unique_id, v_size, v_dur))
                            conn.commit()

            if bot_is_admin and status_msg and (time.time() - last_update_time > 5):
                last_update_time = time.time()
                analyzed_count = total_estimated - current_id
                pct = int((analyzed_count / total_estimated) * 100) if total_estimated > 0 else 0
                pct = max(0, min(100, pct))
                try:
                    await status_msg.edit_text(
                        f"📊 **Escaneo de Historial en Progreso**\n\n"
                        f"📹 Videos analizados: **{analyzed_count} de {total_estimated} ({pct}%)**\n"
                        f"⚠️ Clones detectados: **{duplicates_found}**\n"
                        f"📍 Punto de control: `ID {current_id}`"
                    )
                except Exception:
                    pass

        if bot_is_admin and status_msg:
            await status_msg.edit_text(
                f"✅ **Escaneo de Historial Completado**\n\n"
                f"📹 Total analizados: **{total_scanned}**\n"
                f"🗑️ Clones detectados/eliminados: **{duplicates_found}**"
            )
            asyncio.create_task(delete_message_later(status_msg, delay=10))

        await backup_db_if_changed(client, reason=f"Escaneo /scan completado en {group_id}")

    except Exception as e:
        await send_error_alert(client, "execute_scan_logic", e)
    finally:
        active_scans.discard(group_id)

