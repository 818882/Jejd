        try:
            create_db_backup()
            cursor.execute("DELETE FROM videos WHERE created_at < datetime('now', '-90 days')")
            
            cursor.execute("SELECT DISTINCT group_id FROM videos")
            groups = cursor.fetchall()
            for (g_id,) in groups:
                try:
                    await client.get_chat(g_id)
                except (RPCError, PeerIdInvalid, ValueError):
                    cursor.execute("DELETE FROM videos WHERE group_id = ?", (g_id,))
                    cursor.execute("DELETE FROM user_stats WHERE group_id = ?", (g_id,))
            
            conn.commit()
            cursor.execute("VACUUM")
        except Exception as e:
            await send_error_alert(client, "safe_db_cleanup_worker", e)

