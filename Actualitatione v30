async def run_background_history_scan(client: Client, chat_id: int, is_admin: bool):
    """Procesamiento en segundo plano para no bloquear nuevos envíos en vivo."""
    if chat_id in active_scans:
        return
    active_scans.add(chat_id)

    start_time = time.time()
    processed_count = 0
    in_queue_count = 0
    first_msg_id = None
    last_msg_id = None

    status_msg = None
    if DESTINATION_CHAT_ID:
        try:
            status_msg = await client.send_message(
                chat_id=DESTINATION_CHAT_ID,
                text=f"🔍 **Iniciando Auto-Escaneo de Historial**\n📁 Grupo: `{chat_id}`\n🛡️ Modo: {'ADMINISTRADOR' if is_admin else 'SILENCIOSO (Sin mensajes en origen)'}"
            )
        except Exception:
            pass

    try:
        total_messages = 0
        try:
            total_messages = await client.get_chat_history_count(chat_id)
        except Exception:
            total_messages = 5000

        async for message in client.get_chat_history(chat_id):
            if not first_msg_id: first_msg_id = message.id
            last_msg_id = message.id

            if message.video:
                in_queue_count += 1
                
                # Procesar directamente dentro de la cola
                status, data = await process_single_video_data(client, message, is_admin)
                if status == "valid":
                    v_hash, g_id, v_uniq, v_sz, v_dur, u_id = data
                    cursor.execute("INSERT OR IGNORE INTO videos (phash, group_id, file_unique_id, file_size, duration) VALUES (?, ?, ?, ?, ?)",
                                   (v_hash, g_id, v_uniq, v_sz, v_dur))
                    conn.commit()
                    await safe_copy_message(client, message, DESTINATION_CHAT_ID)

                processed_count += 1
                in_queue_count -= 1

                if processed_count % 10 == 0 and status_msg:
                    elapsed_time = time.time() - start_time
                    speed = processed_count / elapsed_time if elapsed_time > 0 else 1
                    remaining_msgs = max(0, total_messages - processed_count)
                    eta_seconds = int(remaining_msgs / speed) if speed > 0 else 0
                    eta_str = f"{eta_seconds // 60}m {eta_seconds % 60}s"

                    try:
                        await status_msg.edit_text(
                            f"📊 **Auto-Escaneo en Vivo (Almacén)**\n\n"
                            f"📁 **Grupo ID:** `{chat_id}`\n"
                            f"🛡️ **Modo:** {'Admin' if is_admin else 'Silencioso'}\n"
                            f"📥 **Videos Guardados:** `{processed_count}`\n"
                            f"📦 **En Cola local:** `{in_queue_count}`\n"
                            f"📌 **Rango IDs:** `{last_msg_id}` ➔ `{first_msg_id}`\n"
                            f"⏱️ **Tiempo Estimado (ETA):** `{eta_str}`"
                        )
                    except Exception:
                        pass

        cursor.execute("INSERT OR REPLACE INTO scanned_chats (group_id) VALUES (?)", (chat_id,))
        conn.commit()

        if status_msg:
            await status_msg.edit_text(
                f"✅ **Auto-Escaneo de Historial Finalizado**\n"
                f"📁 Grupo ID: `{chat_id}`\n"
                f"🎥 Total Videos Respaldados: `{processed_count}`"
            )

        # Disparar respaldo automático de la DB tras el escaneo
        await backup_db_if_changed(client, reason=f"Auto-Scan completado para grupo {chat_id}")

    except Exception as e:
        await send_error_alert(client, "run_background_history_scan", e)
    finally:
        active_scans.discard(chat_id)

