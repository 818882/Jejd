async def update_backup_channel_counter(client, added_count, group_title=""):
    global backup_channel_msg_id, backup_channel_total_count
    if not DESTINATION_CHAT_ID:
        return

    async with backup_counter_lock:
        backup_channel_total_count += added_count
        now_str = datetime.now().strftime("%H:%M:%S")
        
        in_queue = batch_queue.qsize()
        text = (
            f"📊 **Respaldo en Vivo de Videos**\n\n"
            f"📁 **Origen:** `{group_title if group_title else 'Modo Silencioso'}`\n"
            f"📥 **Videos Procesados:** `{backup_channel_total_count}`\n"
            f"📦 **Lotes en Cola:** `{in_queue}`\n"
            f"⏳ **Videos Pendientes en Fila:** `{in_queue * 5}` aprox.\n"
            f"⏱️ **Última actualización:** `{now_str}`"
        )
        
        try:
            if backup_channel_msg_id is None:
                sent = await client.send_message(DESTINATION_CHAT_ID, text)
                backup_channel_msg_id = sent.id
            else:
                await client.edit_message_text(DESTINATION_CHAT_ID, backup_channel_msg_id, text)
        except Exception:
            try:
                sent = await client.send_message(DESTINATION_CHAT_ID, text)
                backup_channel_msg_id = sent.id
            except Exception as e:
                await send_error_alert(client, "update_backup_channel_counter", e)

