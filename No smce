async def send_error_alert(client, context, error):
    if not MASTER_ADMIN_ID:
        return
    tb = traceback.format_exc()
    error_msg = (
        f"🚨 **ALERTA DE ERROR CRÍTICO**\n\n"
        f"📌 **Origen:** `{context}`\n"
        f"🔴 **Detalle:** `{str(error)}`\n\n"
        f"📄 **Traceback:**\n```python\n{tb[-1000:]}\n```"
    )
    try:
        await client.send_message(chat_id=MASTER_ADMIN_ID, text=error_msg)
        await backup_db_if_changed(client, reason=f"🚨 Respaldo por Error: {context}")
    except Exception as e:
