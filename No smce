async def backup_db_if_changed(client, reason="Respaldo Automático"):
    global LAST_BACKUP_HASH
    if not MASTER_ADMIN_ID or not os.path.exists(DB_PATH):
        return

    current_hash = get_db_hash(DB_PATH)
    if current_hash == LAST_BACKUP_HASH:
        return

    try:
        create_db_backup()
        date_info = get_db_date_range()
        cap = f"🗄️ **Respaldo Automático de Base de Datos**\n\n📌 Motivo: `{reason}`\n🔑 Hash: `{current_hash[:8]}`\n{date_info}"
        await client.send_document(chat_id=MASTER_ADMIN_ID, document=DB_PATH, caption=cap)
        LAST_BACKUP_HASH = current_hash
    except Exception as e:
        print(f"Error al enviar el respaldo automático: {e}")

