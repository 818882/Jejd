        target_dir = os.path.join(DOWNLOADS_DIR, str(chat_id)) if chat_id else DOWNLOADS_DIR
        os.makedirs(target_dir, exist_ok=True)
        final_file_path = os.path.join(target_dir, file_name)

        downloaded = await client.download_media(message_or_file_id, file_name=final_file_path, block=True)
        return downloaded
    except Exception as e:
        await send_error_alert(client, "custom_download_media", e)
        return None

