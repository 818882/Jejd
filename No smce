def get_db_hash(db_path):
    """Calcula el hash MD5 del archivo DB para verificar si cambió."""
    if not os.path.exists(db_path):
        return None
    hasher = hashlib.md5()
    with open(db_path, "rb") as f:
        buf = f.read()
        hasher.update(buf)
    return hasher.hexdigest()

def create_db_backup():
    """Crea una copia rápida (.bak) de la base de datos."""
    try:
        if os.path.exists(DB_PATH):
            shutil.copy2(DB_PATH, DB_BAK_PATH)
    except Exception as e:
        print(f"Error creando backup de BD: {e}")

def restore_db_backup():
    """Restaura la BD desde la copia de respaldo si falla la principal."""
    try:
        if os.path.exists(DB_BAK_PATH):
            shutil.copy2(DB_BAK_PATH, DB_PATH)
            return True
    except Exception as e:
        print(f"Error restaurando backup de BD: {e}")
    return False

